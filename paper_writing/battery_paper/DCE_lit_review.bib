@report{webbConsumerPerspectivesBattery2025,
  title = {Consumer Perspectives on Battery Electric Vehicles : An Analysis of Battery Information and Knowledge},
  shorttitle = {Consumer Perspectives on Battery Electric Vehicles},
  author = {Webb, David and Gore, Christina and Kneifel, Joshua},
  date = {2025-01-30},
  number = {NIST TN 2328},
  pages = {NIST TN 2328},
  institution = {{National Institute of Standards and Technology (U.S.)}},
  location = {Gaithersburg, MD},
  doi = {10.6028/NIST.TN.2328},
  url = {https://nvlpubs.nist.gov/nistpubs/TechnicalNotes/NIST.TN.2328.pdf},
  urldate = {2026-07-06},
  abstract = {Battery electric vehicles (BEVs) adoption in the United States and around the world is increasing rapidly, so understanding consumer preferences and perspectives surrounding BEV adoption is increasingly important. Additionally, most BEVs that have been purchased by consumers have been new vehicles, however the pre-owned market is beginning to develop and take shape. The consumer perspectives and considerations for purchasing a pre-owned BEV may vary significantly from a consumers decision making process when buying a new BEV. This report analyzes survey data on consumer’s preferences for information on the longevity and health of a battery of a used BEV. The survey was conducted in 2023 and includes 1490 individuals of which 490 are current BEV owners. Battery information including expected lifetime and range are viewed as very useful in making vehicle purchasing decisions and BEV owners and potential vehicles purchasers have similar preferences for battery information.},
