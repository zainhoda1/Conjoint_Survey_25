\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Net WTP versus gasoline price: BEV pairs. The blue line and band show simulated Net WTP (mean, 95\% interval) as the gasoline price varies from \$2.50 to \$5.00 per gallon, holding electricity at \$0.17 per kWh; the dashed line is the observed mean real-market price premium (or discount) at approximately three years of age. No matched BEV pair meeting the sample-size threshold was available for the high-budget SUV segment.}}{24}{figure.caption.12}\protected@file@percent }
\newlabel{fig:gas_sensitivity_bev}{{5}{24}{Net WTP versus gasoline price: BEV pairs. The blue line and band show simulated Net WTP (mean, 95\% interval) as the gasoline price varies from \$2.50 to \$5.00 per gallon, holding electricity at \$0.17 per kWh; the dashed line is the observed mean real-market price premium (or discount) at approximately three years of age. No matched BEV pair meeting the sample-size threshold was available for the high-budget SUV segment}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Net WTP versus gasoline price: HEV pairs. The blue line and band show simulated Net WTP (mean, 95\% interval) as the gasoline price varies from \$2.50 to \$5.00 per gallon; the dashed line is the observed mean real-market price premium at approximately three years of age. No matched HEV pair meeting the sample-size threshold was available in either low-budget segment.}}{25}{figure.caption.13}\protected@file@percent }
